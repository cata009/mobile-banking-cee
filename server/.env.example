# Copy to .env.local (ignored by Git). Generate a random value locally.
PLATFORM_AUTH_SECRET=
PLATFORM_ORIGIN=http://localhost:5173
PLATFORM_PORT=8787
# Optional local PostgreSQL URL. Without it, dev uses embedded PostgreSQL in
# ../.codex-temp/flow-rights-local-db. Embedded storage is rejected in production.
DATABASE_URL=
# Shared reader gate uses the existing server's configuration, when needed.
ACCESS_PASSWORD=
ACCESS_COOKIE_SECRET=
