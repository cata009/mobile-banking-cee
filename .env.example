# Server-side stakeholder gate. Set both values in the deployment environment.
ACCESS_PASSWORD=
# Generate an independent random value containing at least 32 characters.
ACCESS_COOKIE_SECRET=

# Vite-only local development credentials. Never reuse production values here.
VITE_LOCAL_ACCESS_PASSWORD=
# Optional: enables local testing of access_token share links.
VITE_LOCAL_SHARE_ACCESS_TOKEN=

# Shared specification storage. Connected private Vercel Blob store injects this
# server-only credential automatically. Never prefix it with VITE_.
BLOB_READ_WRITE_TOKEN=
# Optional OIDC authentication instead of a read-write credential:
BLOB_STORE_ID=
# Production selects Blob automatically when a connected credential is present.
# Set explicitly only for local cloud testing; local Vite defaults to files.
FLOW_SPEC_STORAGE_DRIVER=
# Optional override; defaults to production, or an isolated preview branch name.
FLOW_SPEC_STORAGE_NAMESPACE=
# Non-serverless Node hosts may use a persistent writable volume instead.
FLOW_SPEC_STORAGE_DIR=

# Personal accounts API used to authorize the existing rich editor. Required on
# a future deployment; local Vite defaults to the loopback API on port 8787.
PLATFORM_API_URL=
PLATFORM_ORIGIN=http://localhost:5173
